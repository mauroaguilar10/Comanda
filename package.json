{
  "name": "comanda",
  "private": true,
  "description": "SaaS de pedidos en tiempo real para rotiserías y comercios",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @comanda/shared build && pnpm --parallel --filter @comanda/api --filter @comanda/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  }
}
