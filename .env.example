# Copiá este archivo como .env y completá los valores.
# Nunca subas el .env al repo: está en .gitignore.

# API
PORT=3000
DATABASE_URL=postgres://comanda:comanda@localhost:5432/comanda
# Solo en producción: desde qué dominios la web puede llamar a la API con la cookie.
# CORS_ORIGINS=https://app.mauroaglr.com,https://pedir.mauroaglr.com
# Dirección pública de la API (para las URLs de las fotos guardadas en disco).
# PUBLIC_API_URL=http://localhost:3000

# Fotos en Cloudflare R2 (ver docs/fotos-r2.md). Sin estas cinco, se guardan en apps/api/uploads.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=comanda-fotos
# R2_PUBLIC_URL=https://fotos.mauroaglr.com

# Solo si la API corre detrás de un proxy (Caddy, nginx): así el límite de intentos ve la IP real.
# TRUST_PROXY=true

# Web (se configura en Cloudflare Pages al compilar, no en este archivo)
# VITE_API_URL=https://api.mauroaglr.com

# Postgres de Docker (docker-compose.yml)
POSTGRES_USER=comanda
POSTGRES_PASSWORD=comanda
POSTGRES_DB=comanda
